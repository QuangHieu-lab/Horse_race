PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/horse_racing?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

PASSWORD_RESET_URL=http://localhost:5173/reset-password
