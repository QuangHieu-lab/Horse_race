SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WDP <your-email@gmail.com>"

CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081

ALLOW_MOCK_TOPUP=true

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
